{
  "name": "matter-control",
  "version": "0.2.0",
  "private": true,
  "description": "Matter controller for Windows",
  "author": "Helge Thorsten Kautz",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "cli": "node tools/matter-cli.mjs",
    "dev:ui": "vite --config vite.config.ts"
  },
  "dependencies": {
    "@matter/main": "^0.17.9",
    "@matter/nodejs": "^0.17.9",
    "@matter/types": "^0.17.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-vue": "^5.2.4",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-vue-next": "^0.544.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
